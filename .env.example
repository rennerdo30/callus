# Copy to .env for Docker Compose deployment. Never commit real secrets.

# PostgreSQL credentials
POSTGRES_USER=callus
POSTGRES_PASSWORD=callus_change_me
POSTGRES_DB=callus

# Callus HTTP server
CALLUS_PORT=8080
CALLUS_API_TOKEN=change-this-to-a-long-random-token
CALLUS_DB_MAX_CONNECTIONS=12
CALLUS_WORKER_INTERVAL_SECS=30

# External llama.cpp /v1/embeddings server (optional — omit for pure BM25 + Graph mode)
EMBEDDING_PROVIDER=none
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_URL=http://llama-host:8081/v1/embeddings
# EMBEDDING_MODEL=bge-small-en-v1.5
# EMBEDDING_DIMS=384
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_MS=1500
